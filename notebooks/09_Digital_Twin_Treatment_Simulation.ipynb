    "    '/kaggle/input/datasets/trihuynhviprovcl/tcga-brca/treatments/gdc_brca_clinical_treatments.csv',\n",
    "    '/kaggle/input/datasets/trihuynhviprovcl/tcga-brca/gdc_brca_clinical_treatments.csv'\n",
    "]\n",
    "\n",
    "treatment_path = None\n",
